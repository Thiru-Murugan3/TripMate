DB_URL=jdbc:mysql://localhost:3306/tripmate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
SERVER_PORT=8080

# Generate with: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256bit_secret_here
# Access token expiration in milliseconds (default: 900000 = 15 minutes)
JWT_ACCESS_EXPIRATION=900000
