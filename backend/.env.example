# Copy this file to backend/.env and replace the placeholder values.
# backend/.env is ignored by Git and must never be committed.

DB_URL=jdbc:mysql://localhost:3306/tripmate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
SERVER_PORT=8080

JWT_SECRET=replace_with_a_base64_encoded_secret_at_least_32_bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Google Identity Services (OAuth 2.0 Web Client ID).
# Create a Web application OAuth client and add http://localhost:4200
# as an Authorized JavaScript origin for local development.
GOOGLE_CLIENT_ID=replace_with_your_google_web_client_id.apps.googleusercontent.com

# Brevo transactional email API.
# Configure this once for the TripMate backend. New users do not need Gmail App Passwords.
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME=TripMate

# Local-precedence aliases used by TripMate so stale OS-level BREVO_* values
# cannot override the validated backend/.env configuration.
TRIPMATE_BREVO_API_KEY=replace_with_your_brevo_api_key
TRIPMATE_BREVO_SENDER_EMAIL=verified_sender@example.com
TRIPMATE_BREVO_SENDER_NAME=TripMate
