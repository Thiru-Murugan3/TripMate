# Copy this file to backend/.env and replace the placeholder values.
# backend/.env is ignored by Git and must never be committed.

DB_URL=jdbc:mysql://localhost:3306/tripmate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
SERVER_PORT=8080

JWT_SECRET=replace_with_a_base64_encoded_secret_at_least_32_bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Gmail SMTP (development)
# Enable Google 2-Step Verification, create an App Password, and use that
# 16-character App Password here. Do not use your normal Gmail password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password
MAIL_FROM=yourgmail@gmail.com
