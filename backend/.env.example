# Copy this file to backend/.env and replace the placeholder values.
# backend/.env is ignored by Git and must never be committed.

# Copy the exact same three private values configured on the Render API service.
# TiDB Cloud requires TLS. Never commit the completed backend/.env file.
DB_URL=jdbc:mysql://YOUR_TIDB_HOST:4000/test?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
DB_USERNAME=YOUR_TIDB_USERNAME
DB_PASSWORD=YOUR_TIDB_PASSWORD
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:4200
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

JWT_SECRET=replace_with_a_base64_encoded_secret_at_least_32_bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Cloudflare R2 private object storage.
# Keep R2_ENABLED=false for local-filesystem development, or configure every R2 value below.
R2_ENABLED=false
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET=tripmate-files
R2_PRESIGNED_URL_EXPIRATION=3600

# Brevo transactional email API.
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=thirumuruganofficial3@gmail.com
BREVO_SENDER_NAME=TripMate

TRIPMATE_BREVO_API_KEY=replace_with_your_brevo_api_key
TRIPMATE_BREVO_SENDER_EMAIL=thirumuruganofficial3@gmail.com
TRIPMATE_BREVO_SENDER_NAME=TripMate
