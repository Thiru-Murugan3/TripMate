e":"ATTRACTION","latitude":27.28861111,"longitude":88.56138889,"coordinate_status":"COMMUNITY_SOURCE_REFERENCE_POINT","coordinate_source":"https://en.wikipedia.org/wiki/Rumtek_Monastery","source_provider":"Curated starter / Wikipedia and Commons","source_url":"https://en.wikipedia.org/wiki/Rumtek_Monastery","source_checked_at":"2026-10-14","fee_status":"UNKNOWN","possible_duplicate_group":null,"publication_status":"REVIEW_REQUIRED","fees":[],"photo":{"place_id":"in-26958512700d7c37","file_title":"Rumtek_Monastery_alias_Dharma_Chakra_Centre_near_Gangtok,_East_Sikkim_09.jpg","original_url":"https://upload.wikimedia.org/wikipedia/commons/9/99/Rumtek_Monastery_alias_Dharma_Chakra_Centre_near_Gangtok%2C_East_Sikkim_09.jpg","thumbnail_url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Rumtek_Monastery_alias_Dharma_Chakra_Centre_near_Gangtok%2C_East_Sikkim_09.jpg/500px-Rumtek_Monastery_alias_Dharma_Chakra_Centre_near_Gangtok%2C_East_Sikkim_09.jpg","source_page":"https://commons.wikimedia.org/wiki/File:Rumtek_Monastery_alias_Dharma_Chakra_Centre_near_Gangtok,_East_Sikkim_09.jpg","creator":"Anjan Kumar Kundu","credit":"Own work","license":"CC BY 4.0","license_url":"https://creativecommons.org/licenses/by/4.0","attribution_required":"true","restrictions":"","description":"Rumtek Monastery alias Dharma Chakra Centre near Gangtok in East Sikkim.\nThe monastery was originally built under the direction of Changchub Dorje, 12th Karmapa Lama in the mid-18th century and served as the main seat of the Karma Kagyu lineage. The monastery later was in ruins till the arrival of Rangjung Rigpe Dorje, 16th Karmapa, in Sikkim during the year 1959 after he fled from Tibet to India. The Karmapa decided to rebuild Rumtek as his main seat in exile.\n\nThe sacred items and relics which was brought out from Tsurphu Monastery which served as the Karmapa's seat in Tibet, were installed at Rumtek. the 16th Karmapa officially inaugurated his new seat at Rumtek monastery on the day of Losar festival in 1966 and declared it as Dharmachakra Centre.","capture_date_as_reported":"2024-04-23 12:10:19","upload_timestamp":"2024-06-11T07:22:04Z","metadata_checked_at":"2026-10-14","is_live":false,"review_status":"VISUAL_SCREENING_FROM_STARTER; metadata-sourced identity","attribution_text":"Rumtek_Monastery_alias_Dharma_Chakra_Centre_near_Gangtok,_East_Sikkim_09.jpg — Anjan Kumar Kundu — CC BY 4.0 — https://commons.wikimedia.org/wiki/File:Rumtek_Monastery_alias_Dharma_Chakra_Centre_near_Gangtok,_East_Sikkim_09.jpg","modifications":"None; remote original and provider thumbnail links","local_thumbnail":"thumbnails/in-26958512700d7c37.jpg","photo_id":"in-26958512700d7c37-commons"}},{"place_id":"in-b1fbf52c36a2df15","name":"Seven Sisters Waterfalls","state_ut":"Sikkim","district":null,"tourism_destination":"Gangtok","record_type":"ATTRACTION","latitude":null,"longitude":null,"coordinate_status":"UNKNOWN","coordinate_source":null,"source_provider":"Incredible India / Ministry of Tourism","source_url":"https://www.incredibleindia.gov.in/en/sikkim/gangtok/seven-sisters-waterfalls","source_checked_at":"2026-10-14","fee_status":"UNKNOWN","possible_duplicate_group":null,"publication_status":"REVIEW_REQUIRED","fees":[],"photo":null},{"place_id":"in-4ff5d3d00ecfc184","name":"Singba Rhododendron Sanctuary","state_ut":"Sikkim","district":null,"tourism_destination":"Mangan","record_type":"ATTRACTION","latitude":null,"longitude":null,"coordinate_status":"UNKNOWN","coordinate_source":null,"source_provider":"Incredible India / Ministry of Tourism","source_url":"https://www.incredibleindia.gov.in/en/sikkim/mangan/singba-rhododendron-sanctuary","source_checked_at":"2026-10-14","fee_status":"UNKNOWN","possible_duplicate_group":null,"publication_status":"REVIEW_REQUIRED","fees":[],"photo":null},{"place_id":"in-1217305310e119dc","name":"Singhik Viewpoint","state_ut":"Sikkim","district":null,"tourism_destination":"Mangan","record_type":"ATTRACTION","latitude":null,"longitude":null,"co